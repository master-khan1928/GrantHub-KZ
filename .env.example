BOT_TOKEN=токен_от_BotFather
ADMIN_ID=ваш_telegram_id
TIMEZONE=Asia/Almaty

# --- LLM ---
# На сервере без видеокарты: LLM_PROVIDER=groq и ключ с console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_SCAN_MODEL=openai/gpt-oss-20b
# основной провайдер: ollama (локально, без квоты) или gemini
LLM_PROVIDER=ollama   # ollama (ноутбук) | groq (сервер) | gemini
# запасной, если основной недоступен (можно оставить пустым)
LLM_FALLBACK=

# GEMINI_API_KEY=ключ_Gemini   (нужен только если gemini указан выше)
GEMINI_MODEL=gemini-3.6-flash

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# модель чата без режима размышлений (быстрые ответы консультанта)
OLLAMA_CHAT_MODEL=gemma3:4b
# OLLAMA_TIMEOUT=300
# EXTRACTION_CHUNK_SNIPPETS=12  сколько сниппетов за один вызов модели

# --- Мониторинг ---
# часы плановых запусков сканера (по TIMEZONE), через запятую
SCAN_HOURS=8,20

# --- Сайт ---
WEB_ADMIN_TOKEN=придумайте_длинный_секрет
WEB_PORT=8000
# 1 = сайт сам запускает плановый сканер (только если Telegram-бот не запущен)
WEB_RUN_SCHEDULER=0

# --- Связка бота и сайта ---
# публичный адрес сайта для кнопки в Telegram (localhost показывается текстом)
SITE_URL=http://localhost:8000
# Имя бота без @ — для ссылки «Открыть бота» при привязке Telegram на сайте (t.me/<имя>?start=link_КОД)
BOT_USERNAME=
# --- Скорость ИИ ---
# контекст сканера / чата; 8192+6144 целиком влезают в 6 ГБ видеопамяти
OLLAMA_NUM_CTX=8192
CHAT_NUM_CTX=6144
CHAT_NUM_PREDICT=700
OLLAMA_KEEP_ALIVE=60m

# --- Авторизация сайта ---
SESSION_SECRET=длинный_случайный_секрет

# --- Каталог: очистка и модерация ---
# сколько запусков подряд грант может не встретиться в поиске, прежде чем его снимет автоочистка
SWEEP_MAX_MISSES=6
# doubtful = на проверку идут только записи с неподтверждённой страной; all = все новые записи
REVIEW_MODE=doubtful

# --- Защита и кэш ---
# запросов к API с одного IP в минуту
API_RATE_LIMIT=100
# разрешённые сторонние домены фронтенда через запятую (пусто = только свой домен)
CORS_ORIGINS=
# сколько секунд браузер и CDN кэшируют /static
STATIC_MAX_AGE=3600
# отслеживание ошибок: нужен pip install sentry-sdk
SENTRY_DSN=
# сколько ежедневных копий базы хранить в data/backups
BACKUP_KEEP=7
